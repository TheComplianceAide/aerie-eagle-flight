{
  "version": "2.0",
  "extensions": { "http": { "routePrefix": "api" } },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 5,
        "evaluationInterval": "00:00:30",
        "excludedTypes": "Exception"
      }
    }
  }
}
